# Copia este archivo como .env.local y rellena los valores
# .env.local nunca se sube al repositorio

# Supabase — obtener en https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side ÚNICAMENTE (NUNCA exponer al cliente).
# Usado por server actions del panel de coordinación para crear usuarios en
# Supabase Auth (admin.auth.admin.createUser). En producción debe configurarse
# como variable de entorno en Vercel (Project Settings → Environment Variables)
# marcada como secret, no como NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Las siguientes se configuran SOLO en Supabase Dashboard
# (Project Settings → Edge Functions → Secrets), no aquí:
#   GEMINI_API_KEY      — usado por Edge Function ask-agent (Semana 7)
#   GROQ_API_KEY        — fallback del agente (Semana 7)
